{$DOMAIN} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		@assets path /assets/*
		@pages not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
