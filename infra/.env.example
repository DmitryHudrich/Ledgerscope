# Copy to infra/.env — compose reads it automatically.

# Required. JSON-RPC endpoint the fetcher walks blocks with.
ETH_RPC_URL=https://mainnet.infura.io/v3/<project-id>
ETH_RPC_RPS=15

# SOCKS/HTTP proxy for the RPC calls. The services run on the host network
# namespace, so 127.0.0.1 here is your host's loopback — the same address the
# binary uses outside Docker. Set to an empty value for a direct connection.
ETH_RPC_PROXY=socks5h://127.0.0.1:2080

# Host ports. WEB_PORT must stay above 1024 (nginx runs unprivileged).
# The API binds 127.0.0.1 only; the browser reaches it through WEB_PORT/api.
WEB_PORT=8080
API_PORT=3000

RUST_LOG=info

# ClickHouse. The image drops its `default` user as soon as CLICKHOUSE_USER is
# set, so these are the only credentials that work afterwards.
CLICKHOUSE_DB=ledgerscope
CLICKHOUSE_USER=ledgerscope
CLICKHOUSE_PASSWORD=ledgerscope

# Path to the YAML config for the API. Unset = ./config.yaml if it exists,
# otherwise the variables above plus built-in defaults.
# LEDGERSCOPE_CONFIG=/etc/ledgerscope/config.yaml
