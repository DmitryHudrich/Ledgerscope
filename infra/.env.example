# Copy to infra/.env — compose reads it automatically.

# Your own mainnet JSON-RPC endpoint. Optional when chainlist is on: its
# public nodes are pooled per chain and prioritised by latency.
ETH_RPC_URL=https://mainnet.infura.io/v3/<project-id>
ETH_RPC_RPS=15

# Pull public rpc nodes from chainlist.org and serve every Ethereum L2 it knows.
RPC_CHAINLIST=true
CHAINS_ETHEREUM_L2=true

# Tron mainnet: TRX, TRC-10 and TRC-20 over the native /wallet API of public nodes.
CHAINS_TRON=true

# Public testnets for both families: ethereum (Sepolia/Hoodi + L2 testnets from
# chainlist) and tron (Nile/Shasta). Needs CHAINS_TRON for the tron ones.
CHAINS_TESTNETS=true

# SOCKS/HTTP proxy for the RPC calls. The services run on the host network
# namespace, so 127.0.0.1 here is your host's loopback — the same address the
# binary uses outside Docker. Set to an empty value for a direct connection.
ETH_RPC_PROXY=socks5h://127.0.0.1:2080

# Etherscan address nametags, dumped to a JSON file and read once at startup.
ETHERSCAN_JSON_PATH=labels.json

# Host ports. WEB_PORT must stay above 1024 (nginx runs unprivileged).
# The API binds 127.0.0.1 only; the browser reaches it through WEB_PORT/api.
WEB_PORT=8080
API_PORT=3000

RUST_LOG=info

# ClickHouse. The image drops its `default` user as soon as CLICKHOUSE_USER is
# set, so these are the only credentials that work afterwards.
CLICKHOUSE_DB=ledgerscope
CLICKHOUSE_USER=ledgerscope
CLICKHOUSE_PASSWORD=ledgerscope

POSTGRES_DB=ledgerscope
POSTGRES_USER=ledgerscope
POSTGRES_PASSWORD=ledgerscope
POSTGRES_PORT=5432

AUTH_COOKIE_SECURE=false
AUTH_REGISTRATION=true

# Local eth devnet (anvil), served alongside the other chains for quick testing.
CHAINS_DEVNETS=true
DEVNET_EVM_RPC=http://127.0.0.1:8545
DEVNET_PORT=8545
DEVNET_CHAIN_ID=31337

# Passive tls observer: ingest endpoint + ip-to-wallet correlation. The token
# guards POST /tls/observations; the observer agent sends it as a bearer.
OBSERVER_ENABLED=true
OBSERVER_TOKEN=devnet-observer-token
