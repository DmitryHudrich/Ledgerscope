# Rendered by the nginx entrypoint (envsubst) at container start. Only WEB_PORT
# and API_PORT are substituted — NGINX_ENVSUBST_FILTER keeps nginx's own $uri,
# $host and friends untouched.
server {
    listen ${WEB_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;
    gzip_min_length 1024;

    # Hashed filenames, so the bundle can be cached indefinitely.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Mirrors the Vite dev proxy: /api/<path> -> web-api /<path>. Both services
    # share the host network namespace, so the API is on loopback here.
    location /api/ {
        proxy_pass http://127.0.0.1:${API_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # /graph seeds every block in the range over JSON-RPC before it answers,
        # which for a wide range takes minutes.
        proxy_connect_timeout 10s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;
        proxy_buffering off;
    }
}
