# Copy to .env next to docker-compose.yaml:  cp .env.example .env
# Compose reads it automatically.

COMPOSE_PROJECT_NAME=paytraces

# ---------------------------------------------------------------- egress ----
# All external blockchain APIs are reached through the `proxy` service
# (gost, socks5 on :1080). The engine never dials the internet directly.
#
# Leave PROXY_UPSTREAM_ARG empty to egress straight from the proxy container.
# To chain to your own proxy, set the gost forward flag, e.g.
#   PROXY_UPSTREAM_ARG=-F socks5://host.docker.internal:2080
#   PROXY_UPSTREAM_ARG=-F socks5://user:pass@vpn.example:1080
#   PROXY_UPSTREAM_ARG=-F http://squid.internal:3128
PROXY_UPSTREAM_ARG=

# What the engine dials. Keep socks5h:// so DNS is resolved by the proxy.
ENGINE_PROXY_URL=socks5h://proxy:1080

# Build-time proxy — only needed when crates.io / NuGet / npm are unreachable
# without one. Unrelated to the runtime proxy above.
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=localhost,127.0.0.1

# ------------------------------------------------------------ provider keys --
# REQUIRED. config.yaml wires chain 1 to a routed source over etherscan +
# alchemy; the engine refuses to start ("... has no api keys") without both.
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
# Optional: only used when the corresponding source is wired in config.yaml.
MORALIS_API_KEY=
TRONGRID_API_KEY=

# ------------------------------------------------------------------ secrets --
# Shared secret the C# facade presents to the Rust engine (X-Api-Key).
# Empty = engine accepts unauthenticated internal calls (dev only).
ENGINE_API_KEY=dev-engine-shared-secret-change-me
# JWT signing key for the public API. Change for anything but local dev.
JWT_SIGNING_KEY=dev-only-change-me-ledgerscope-signing-key-0123456789
JWT_ISSUER=ledgerscope-accounts
JWT_AUDIENCE=ledgerscope-clients

# ----------------------------------------------------------------- runtime --
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet_db
POSTGRES_PORT=5432
REDIS_PORT=6379

# Development keeps the dev seed + Scalar UI enabled on the C# API.
ASPNETCORE_ENVIRONMENT=Development
GRAPH_ENGINE_TIMEOUT_SECONDS=30

TELEMETRY_ENABLED=true

# ------------------------------------------------------------- host ports ---
FRONTEND_PORT=8081
ACCOUNTS_PORT=5107
ENGINE_PORT=8080
